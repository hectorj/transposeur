{
  "name": "transposeur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transposeur \u2014 formant-preserving pitch and tempo control for audio and video in Chrome and Firefox",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 tests/settings.test.mjs tests/i18n.test.mjs tests/dsp.test.mjs tests/extension.test.mjs tests/firefox.test.mjs",
    "test:dsp": "node --test tests/dsp.test.mjs",
    "test:extension": "node scripts/build.mjs && node --test tests/extension.test.mjs",
    "lint:firefox": "node scripts/build.mjs && web-ext lint -s dist/firefox",
    "test:firefox": "node scripts/build.mjs && node --test tests/firefox.test.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "sign:firefox": "node scripts/build.mjs && ./scripts/with-env.sh web-ext sign -s dist/firefox --channel=unlisted --artifacts-dir=dist"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0"
  }
}
